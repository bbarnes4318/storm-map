# ==============================================================================
# Mapbox
# ==============================================================================

# Public Access Token (Required for Mapbox GL JS basemaps and v6 reverse geocoding API)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# ==============================================================================
# PostgreSQL Database
# ==============================================================================

# Credentials used by docker-compose for the postgres service container.
# These are interpolated into docker-compose.yml via ${VARIABLE:-default} syntax.
POSTGRES_USER=stormmap
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=storm_map

# Full connection string used by the Next.js app and Drizzle ORM.
# In docker-compose, "postgres" is the service hostname.
# For local development without Docker, use localhost:5432.
DATABASE_URL=postgresql://stormmap:changeme_local_only@postgres:5432/storm_map

# ==============================================================================
# Enrichment Feature Safety Flags
# ==============================================================================

# Master kill switch. Routes return 503 FEATURE_DISABLED unless set to "true".
ENRICHMENT_FEATURE_ENABLED=false

# Use mock providers/stores instead of real vendors + PostgreSQL.
ENRICHMENT_MOCK_MODE=true

# In production (NODE_ENV=production), mock mode is blocked by default.
# Set to "true" ONLY for controlled testing. Requires ENRICHMENT_ADMIN_TEST_TOKEN.
ENRICHMENT_ALLOW_MOCK_IN_PRODUCTION=false

# Required when ENRICHMENT_ALLOW_MOCK_IN_PRODUCTION=true.
# All mock-mode requests in production must include the header:
#   x-enrichment-test-token: <this value>
ENRICHMENT_ADMIN_TEST_TOKEN=replace_with_secure_random_token

# ==============================================================================
# Enrichment Encryption
# ==============================================================================

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of contact payloads.
ENRICHMENT_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ==============================================================================
# Clerk Authentication
# ==============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/storm-map
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/storm-map
