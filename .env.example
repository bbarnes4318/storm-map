# Mapbox Public Access Token (Required for Mapbox GL JS basemaps and v6 reverse geocoding API)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Server-Side Postgres Database connection
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-Side Enrichment Payload Symmetric Encryption Key (32-byte Base64 encoded key)
ENRICHMENT_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Enrichment Service Routing Mode (Set to true to use Mock Provider for local testing/avoid charges)
ENRICHMENT_MOCK_MODE=true
